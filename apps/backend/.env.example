# Flask
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# SQLAlchemy — SQLite for prototyping, MySQL for production
# SQLite (default): no server needed, file-based
DATABASE_URL=sqlite:///cokedecide.db
# MySQL (production): uncomment when ready
# DATABASE_URL=mysql+pymysql://root:root@localhost/cokedecide

# MongoDB — connection for documents and attachments
MONGO_URI=mongodb://localhost:27017/cokedecide
MONGO_DB_NAME=cokedecide
