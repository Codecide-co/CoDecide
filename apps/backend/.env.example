# Flask
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# SQLAlchemy
DATABASE_URL=sqlite:///CoDecide.db

# MongoDB — connection for documents and attachments
MONGO_URI=mongodb://localhost:27017/CoDecide
MONGO_DB_NAME=CoDecide

# JWT
JWT_SECRET_KEY=change-this-in-production

# CORS
CORS_ORIGINS=http://localhost:5173

# Uploads
UPLOAD_FOLDER=
MAX_FILE_SIZE_MB=16
